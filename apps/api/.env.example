UHT_API_HOST=127.0.0.1
UHT_API_PORT=8000
UHT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UHT_LAB_STATE_DIR=/tmp/uht-api-labs
UHT_RATE_LIMIT_REQUESTS=60
UHT_RATE_LIMIT_WINDOW_SECONDS=60
UHT_MAX_REQUEST_BYTES=65536
UHT_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://uht:uht-development-only@127.0.0.1:5432/uht
SESSION_SECRET=replace-with-a-long-random-development-secret
CSRF_SECRET=replace-with-a-long-random-development-secret
UHT_SECURE_COOKIES=false
UHT_SESSION_TTL_SECONDS=1209600
UHT_SESSION_IDLE_SECONDS=86400
UHT_EMAIL_BACKEND=development-in-memory
