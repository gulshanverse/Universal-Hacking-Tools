{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Universal Hacking Tools Phase 6 Lab Definition",
  "type": "object",
  "required": ["id", "name", "description", "difficulty", "category", "objectives", "prerequisites", "environment", "targets", "allowed_actions", "tasks", "evidence", "assessment", "cleanup", "safety", "learning"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "name": {"type": "string", "minLength": 3},
    "description": {"type": "string", "minLength": 10},
    "difficulty": {"enum": ["beginner", "intermediate", "advanced"]},
    "category": {"type": "string", "minLength": 2},
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "prerequisites": {"type": "array", "items": {"type": "object", "required": ["target", "type"], "properties": {"target": {"type": "string"}, "type": {"enum": ["required", "recommended", "helpful"]}}}},
    "environment": {"type": "object", "required": ["type", "isolation", "network_policy", "resources"], "properties": {"type": {"const": "local-fixture"}, "isolation": {"const": "dedicated-ephemeral"}, "network_policy": {"const": "isolated-no-internet"}, "resources": {"type": "object", "required": ["cpu_limit", "memory_limit", "pids_limit", "execution_timeout", "max_instances"]}}},
    "targets": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "type", "fixture", "role"], "properties": {"id": {"type": "string"}, "type": {"const": "synthetic-fixture"}, "fixture": {"type": "string"}, "role": {"type": "string"}}}},
    "allowed_actions": {"type": "array", "minItems": 1, "items": {"enum": ["inspect_fixture", "inspect_dns_record", "inspect_tls_metadata", "inspect_http_response", "inspect_log", "inspect_iac_manifest", "inspect_container_config", "record_answer"]}},
    "tasks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "objective", "description", "action", "target", "evidence_id"], "properties": {"id": {"type": "string"}, "objective": {"type": "string"}, "description": {"type": "string"}, "action": {"type": "string"}, "target": {"type": "string"}, "evidence_id": {"type": "string"}}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "type", "description", "required"], "properties": {"id": {"type": "string"}, "type": {"enum": ["observation", "artifact", "finding", "configuration", "log-entry", "request-response", "screenshot-reference", "answer"]}, "description": {"type": "string"}, "required": {"type": "boolean"}}}},
    "assessment": {"type": "object", "required": ["type", "criteria"], "properties": {"type": {"const": "deterministic-evidence"}, "criteria": {"type": "array", "minItems": 1}}},
    "cleanup": {"type": "object", "required": ["automatic", "reset_supported", "retention"], "properties": {"automatic": {"const": true}, "reset_supported": {"const": true}, "retention": {"const": "ephemeral"}}},
    "safety": {"type": "object", "required": ["scope", "authorized_only", "internet_access", "isolation_required", "host_networking", "privileged", "host_mounts"], "properties": {"scope": {"const": "local-synthetic-fixture"}, "authorized_only": {"const": true}, "internet_access": {"const": false}, "isolation_required": {"const": true}, "host_networking": {"const": false}, "privileged": {"const": false}, "host_mounts": {"const": false}}},
    "learning": {"type": "object", "required": ["concepts", "techniques", "tools", "vulnerabilities", "defensive_controls", "learning_paths"], "properties": {"concepts": {"type": "array", "items": {"type": "string"}}, "techniques": {"type": "array", "items": {"type": "string"}}, "tools": {"type": "array", "items": {"type": "string"}}, "vulnerabilities": {"type": "array", "items": {"type": "string"}}, "defensive_controls": {"type": "array", "items": {"type": "string"}}, "learning_paths": {"type": "array", "items": {"type": "string"}}}}
  }
}
