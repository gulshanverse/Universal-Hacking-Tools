{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gulshanverse/Universal-Hacking-Tools/schemas/claim.schema.json",
  "title": "Evidence-backed claims",
  "type": "object",
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "evidence", "status", "confidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "statement": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source", "note"],
              "properties": {"source": {"type": "string", "minLength": 1}, "note": {"type": "string", "minLength": 1}}
            }
          },
          "status": {"enum": ["verified", "partially-verified", "needs-review", "disputed", "deprecated"]},
          "confidence": {"enum": ["high", "medium", "low", "unknown"]}
        }
      }
    }
  }
}
